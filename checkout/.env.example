# Local sandbox checkout; never commit real values.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Signing secret from Stripe Workbench for POST /api/webhook.
STRIPE_WEBHOOK_SECRET=
CHECKOUT_ENABLED=false
CHECKOUT_BASE_URL=http://127.0.0.1:4173
BLOB_PATHNAME=releases/yaprflow-5.2.12.dmg
BLOB_READ_WRITE_TOKEN=
# At least 32 random characters. Keep the same value so emailed links remain valid.
DOWNLOAD_LINK_SECRET=
# Transactional download delivery and optional newsletter opt-ins.
RESEND_API_KEY=
PURCHASE_EMAIL_FROM=Yaprflow <downloads@yaprflow.com>
PURCHASE_EMAIL_REPLY_TO=hello@yaprflow.com
RESEND_NEWSLETTER_SEGMENT_ID=
# Optional comma-separated older purchase prices.
STRIPE_ALLOWED_PRICE_IDS=
# Optional website microphone demo (the Mac app remains local).
OPENAI_API_KEY=
